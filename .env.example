DATABASE_URL=postgres://midfunnel:midfunnel@localhost:5433/midfunnel_dev
TEST_DATABASE_URL=postgres://midfunnel:midfunnel@localhost:5433/midfunnel_test
# Leave EMPTY rather than writing a placeholder: this file overrides the ambient
# environment, and a placeholder that looks like a key produces a confident 401.
OPENAI_API_KEY=

# Model selection.
#   dev  (default) - terra everywhere. Build, debug and A/B here.
#   demo           - sol for the agent and the judge, luna for personas.
MODEL_PROFILE=dev
# Per-role overrides, if you need one without switching profile:
# MODEL_RUNTIME=
# MODEL_EXTRACTOR=
# MODEL_JUDGE=
# MODEL_PERSONA=
# MODEL_INSIGHTS=
# MODEL_COPILOT=

# Bearer token for the API. Unset means the guard is not installed, which is
# fine on a laptop and wrong for anything reachable.
# API_TOKEN=
