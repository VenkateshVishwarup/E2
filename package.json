{
  "name": "midfunnel",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:migrate": "tsx packages/core/src/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/runtime/tsconfig.json && tsc --noEmit -p packages/batch/tsconfig.json && tsc --noEmit -p packages/intelligence/tsconfig.json && tsc --noEmit -p packages/web/tsconfig.json && tsc --noEmit -p packages/console/tsconfig.json",
    "seed": "tsx scripts/seed-and-replay.ts",
    "simulate": "tsx scripts/simulate-and-eval.ts",
    "simulate:demo": "MODEL_PROFILE=demo tsx scripts/simulate-and-eval.ts",
    "roi": "tsx scripts/close-the-loop.ts",
    "roi:demo": "MODEL_PROFILE=demo tsx scripts/close-the-loop.ts",
    "db:migrate:remote": "tsx scripts/migrate-remote.ts",
    "seed:remote": "tsx scripts/close-the-loop.ts",
    "okf:bundle": "tsx scripts/bundle-okf.ts",
    "build:console": "npm run okf:bundle && npm run build -w @midfunnel/console",
    "build:api": "esbuild server/api-handler.ts --bundle --platform=node --target=node24 --format=esm --outfile=api/index.js --log-level=warning --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\"",
    "build:vercel": "npm run build -w @midfunnel/console && npm run build:api"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.0",
    "esbuild": "^0.21.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@neon/config": "^1.3.0",
    "@neon/env": "^1.2.1",
    "pg": "^8.13.0"
  }
}
